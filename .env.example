# BHŪ-TATTVA-ANVEṢA Configuration Environment Variables

PROJECT_NAME="BHŪ-TATTVA-ANVEṢA"
APP_MODE=development
DATA_MODE=mock
GRID_RESOLUTION=100

# PostgreSQL / PostGIS
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=bhu_tattva_db
POSTGRES_USER=bhu_admin
POSTGRES_PASSWORD=bhu_secure_pass

# Neo4j Graph DB
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=bhu_graph_pass

# Backend API
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# LLM & GEE Config Placeholders (Unset by default)
LLM_PROVIDER=mock
OPENAI_API_KEY=
EE_PROJECT_ID=
